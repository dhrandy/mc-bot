# Copy to .env and set each value. Never commit your filled .env.
MC_HOST=minecraft.example.net
MC_PORT=25565
MC_VERSION=
MC_ACCOUNT_ID=bot-account-alias
API_PORT=42883
API_TOKEN=replace-with-a-random-secret-at-least-32-characters

# Optional Crafty Controller integration. Leave all three blank to disable.
CRAFTY_API_BASE_URL=
CRAFTY_SERVER_ID=
CRAFTY_API_TOKEN=

AUTO_DEFEND=false
AUTO_EAT=false

# Join the server when the container starts. Off by default: the bot waits
# for Join on the control panel or POST /api/join.
AUTO_JOIN=false

# Run from creepers on sight. Also toggleable on the control panel and
# through POST /api/auto-flee.
AUTO_FLEE=false
